@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Modificar Historia";
}

<h1>Modificar Historia</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Titulo" class="control-label"></label>
        <input asp-for="Titulo" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Sinopsis" class="control-label"></label>
        <textarea asp-for="Sinopsis" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="CategoriaIds" class="control-label">Categorías</label>
            <select asp-for="CategoriaIds" class="form-control" multiple>
                @foreach (var categoria in ViewBag.Categorias)
                {
                    if (Model.CategoriaIds?.Contains(categoria.Id) == true)
                    {
                        <option value="@categoria.Id" selected>@categoria.Nombre</option>
                    }
                    else
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                }
            </select>
    </div>
    <div class="form-group">
        <label asp-for="Estado" class="control-label">Estado</label>
        <select asp-for="Estado" class="form-control">
            <option value="0">Borrador</option>
            <option value="1">Publicada</option>
        </select>
    </div>

    <h4 class="mt-3">Capítulo inicial</h4>
    <input type="hidden" asp-for="CapituloInicial.Id" />
    <input type="hidden" asp-for="CapituloInicial.idHistoria" />
    @if (Model.Capitulos != null && Model.Capitulos.Count > 1)
    {
        <div class="alert alert-info">
            El capítulo inicial no se puede modificar porque la historia ya posee otros capítulos agregados.
        </div>
        <div class="form-group">
            <label asp-for="CapituloInicial.Titulo" class="control-label">Título del capítulo inicial</label>
            <input asp-for="CapituloInicial.Titulo" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="CapituloInicial.Texto" class="control-label">Texto del capítulo inicial</label>
            <textarea asp-for="CapituloInicial.Texto" class="form-control" readonly></textarea>
        </div>
    }
    else
    {
        <div class="form-group">
            <label asp-for="CapituloInicial.Titulo" class="control-label">Título del capítulo inicial</label>
            <input asp-for="CapituloInicial.Titulo" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="CapituloInicial.Texto" class="control-label">Texto del capítulo inicial</label>
            <textarea asp-for="CapituloInicial.Texto" class="form-control"></textarea>
        </div>
    }

    <div class="form-group mt-2">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}