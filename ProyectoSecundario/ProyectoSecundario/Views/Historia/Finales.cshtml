@model ProyectoSecundario.Models.FinalesHistoriaViewModel

@{
    ViewData["Title"] = "Final más alcanzado";
}

<h1>Final más alcanzado por historia</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<form asp-action="Finales" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-6">
        <label for="idHistoria" class="form-label">Seleccione una historia</label>
        <select id="idHistoria" name="idHistoria" class="form-select">
            <option value="">Seleccione una historia</option>
            @foreach (HistoriaModel historia in Model.Historias)
            {
                if (Model.IdHistoriaSeleccionada == historia.Id)
                {
                    <option value="@historia.Id" selected>@historia.Titulo</option>
                }
                else
                {
                    <option value="@historia.Id">@historia.Titulo</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Consultar</button>
    </div>
</form>

@if (Model.Reporte != null)
{
    <h2>@Model.Reporte.TituloHistoria</h2>

    @if (Model.Reporte.Finales.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Final</th>
                    <th>Veces alcanzado</th>
                    <th>Resultado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FinalFrecuenciaModel final in Model.Reporte.Finales)
                {
                    <tr class="@(final.EsMasFrecuente ? "table-success" : string.Empty)">
                        <td>@final.Titulo</td>
                        <td>@final.CantidadVecesAlcanzado</td>
                        <td>
                            @if (final.EsMasFrecuente)
                            {
                                <strong>Más frecuente</strong>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            La historia no tiene finales registrados.
        </div>
    }
}
