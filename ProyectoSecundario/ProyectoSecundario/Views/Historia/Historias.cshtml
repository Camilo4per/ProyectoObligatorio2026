@model CatalogoViewModel

@{
    ViewData["Title"] = "Historias";
}

<h1>Historias disponibles</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<form asp-action="Historias" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label for="idCategoria" class="form-label">Filtrar por categoría</label>
        <select id="idCategoria" name="idCategoria" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (CategoriaModel categoria in Model.Categorias)
            {
                if (Model.IdCategoriaSeleccionada == categoria.Id)
                {
                    <option value="@categoria.Id" selected>@categoria.Nombre</option>
                }
                else
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
</form>

@if (Model.Historias.Count == 0)
{
    <p class="text-muted">No hay historias publicadas para mostrar.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (HistoriaCatalogoModel historia in Model.Historias)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@historia.Titulo</h5>
                        <p class="card-text">@historia.Sinopsis</p>
                        <p>
                            @foreach (CategoriaModel categoria in historia.Categorias)
                            {
                                <span class="badge bg-secondary">@categoria.Nombre</span>
                            }
                        </p>
                    </div>
                    <div class="card-footer">
                        <form asp-controller="Lectura" asp-action="Comenzar" method="post">
                            <input type="hidden" name="idHistoria" value="@historia.Id" />
                            <button type="submit" class="btn btn-primary">Comenzar lectura</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
