@model IEnumerable<ProyectoSecundario.Models.HistoriaRankingModel>

@{
    ViewData["Title"] = "Ranking de historias";
}

<h1>Ranking de historias más leídas</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}
else if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Posición</th>
                <th>Historia</th>
                <th>Lecturas completadas</th>
            </tr>
        </thead>
        <tbody>
            @{ int posicion = 1; }

            @foreach (HistoriaRankingModel historia in Model)
            {
                <tr>
                    <td>@posicion</td>
                    <td>@historia.Titulo</td>
                    <td>@historia.CantidadLecturasCompletadas</td>
                </tr>

                posicion++;
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info" role="alert">
        No existen historias con lecturas completadas.
    </div>
}
