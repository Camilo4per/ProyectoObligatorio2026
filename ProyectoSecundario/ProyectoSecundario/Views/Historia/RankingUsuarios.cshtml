@model IEnumerable<ProyectoSecundario.Models.UsuarioRankingModel>

@{
    ViewData["Title"] = "Ranking de usuarios";
}

<h1>Usuarios con más historias leídas</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}
else if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Posición</th>
                <th>Usuario</th>
                <th>Historias completadas</th>
            </tr>
        </thead>
        <tbody>
            @{ int posicion = 1; }

            @foreach (UsuarioRankingModel usuario in Model)
            {
                <tr>
                    <td>@posicion</td>
                    <td>@usuario.NombreUsuario</td>
                    <td>@usuario.CantidadHistoriasCompletadas</td>
                </tr>

                posicion++;
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info" role="alert">
        No existen usuarios con historias completadas.
    </div>
}
