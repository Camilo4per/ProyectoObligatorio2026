@{
    // Obtiene el estilo de lectura desde la sesión, si no está establecido, se asume "Claro"
    string estiloLectura = Context.Session.GetString("EstiloLectura") == "Oscuro"
        ? "Oscuro"
        : "Claro";

    // Determina la clase CSS correspondiente al estilo de lectura
    string claseEstilo = estiloLectura == "Oscuro"
        ? "tema-oscuro"
        : "tema-claro";

    // Construye la URL de retorno para mantener al usuario en la misma página después de cambiar el estilo
    string returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoSecundario</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoSecundario.styles.css" asp-append-version="true" />
</head>
<body class="@claseEstilo">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProyectoSecundario</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                   
                        

                        @if (Context.Session.GetString("Rol") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Historia" asp-action="Index">Home</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") == "Administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Historia" asp-action="Ranking">Ranking de historias</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Historia" asp-action="Finales">Final más alcanzado</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Historia" asp-action="RankingUsuarios">Ranking de usuarios</a>
                            </li>
                        }
                        
                        @if (Context.Session.GetString("Rol") == "Usuario")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Historia" asp-action="Historias">Historias</a>
                            </li>   

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Lectura" asp-action="Historial">Historial Lecturas</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Rol") == "Usuario")
                        {
                            <li class="nav-item ms-auto">
                                <form asp-controller="Auth" asp-action="CambiarEstilo" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="estilo" value="@(estiloLectura == "Claro" ? "Oscuro" : "Claro")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="nav-link btn btn-link">
                                        @(estiloLectura == "Claro" ? "Activar modo oscuro" : "Activar modo claro")
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <p>
            &copy; 2026 - Obligatorio / Desarrollo Web Asistido con IA - Camilo Pereira, Ignacio Alvez
            @if (Context.Session.GetString("token") != null)
            {
                <span> | </span>
                <span class="text-primary">Logeado: @Context.Session.GetString("NombreUsuario")</span>
            }
        </p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
